{
  "name": "yarok",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix site install",
    "dev": "concurrently -k -n api,site -c blue,green \"npm:dev:api\" \"npm:dev:site\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:site": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "start": "tsx server/index.ts",
    "setup": "tsx server/scripts/setup.ts",
    "create-user": "tsx server/scripts/create-user.ts",
    "test:site": "tsx server/scripts/smoke-test-site.ts",
    "test:employees": "tsx server/scripts/smoke-test.ts",
    "test:messaging": "tsx server/scripts/test-messaging.ts",
    "test": "npm run test:employees && npm run test:site && npm --prefix site test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.12",
    "sift": "^17.1.3",
    "tsx": "^4.20.6",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.16.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "mailparser": "^3.9.31",
    "smtp-server": "^3.19.15",
    "typescript": "^5.8.3"
  }
}
